;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.advisor&q;:[{&q;uuid&q;:&q;e1cbec8b-a248-4688-a253-c5871ea57aeb&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Rivera Rodríguez, Sergio Raúl&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;9db24c88-dcf0-46c5-8a4b-192caab11db0&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Nitola Chaparro, Lizeth Alejandra&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.contributor.researchgroup&q;:[{&q;uuid&q;:&q;6ee40b43-43de-4426-ba19-73929c53f6f5&q;,&q;language&q;:&q;spa&q;,&q;value&q;:&q;Grupo de Investigación EMC-UN&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;68ff4177-5746-4b11-a930-9c0986e0bb57&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2021-06-08T17:13:59Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;432e9515-703a-47fc-a015-593d1bad528f&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2021-06-08T17:13:59Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;032d50b5-86ac-497b-9df0-fb16dcb7e980&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2021&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description&q;:[{&q;uuid&q;:&q;20e77385-9fea-4fd8-ab17-4338ff5a6bfb&q;,&q;language&q;:&q;spa&q;,&q;value&q;:&q;ilustraciones, graficas&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;304bb964-584c-4d16-880a-30fb4d10a974&q;,&q;language&q;:&q;spa&q;,&q;value&q;:&q;El presente estudio revisa el impacto que se puede presentar por la inmersión de fuentes de generación a la red de distribución, con un enfoque técnico, operativo y comercial, \r\ndadas por las transacciones de energía entre cliente y operador. De esta manera se \r\nrequiere de un arreglo matemático que permita identificar el balance entre la congestión y \r\nel costo de operación de una microred. en el momento de realizar la programación de la \r\noperación del sistema en un horizonte de tiempo de 24 horas. Así la investigación se \r\nencamina a la solución mediante algoritmos heurísticos, que permiten abordar las \r\nrestricciones no-covexas del planteamiento del problema propuesto.\r\nEl algoritmo de optimización propuesto para el análisis esta dado por el método de \r\noptimización de enjambre de partículas multiobjetivo (MOPSO), proporcionando un \r\nconjunto de soluciones que son conocidas como Pareto óptimo. Este algoritmo se plantea \r\nen un sistema IEEE de 141 buses/nodos, el cual consta de una red radial de distribución \r\nque considera 141 buses usado como uno de los casos base o caso de estudio en \r\nMatpower. Para ello, este sistema fue modificado y enél se incluyeron una serie de\r\ninyecciones de generación renovable, sistemas que coordinan vehículos eléctricos,\r\n(agregadores), almacenamiento en baterías y el nodo slack se mantuvo igual que el caso \r\nbase y se asumió que este tiene (generación tradicional). \r\nAl final se puede evidenciar que el algoritmo puede aportar soluciones para la planificación \r\nde la operación de la red, probar la robustez del sistema y verificar algunas contingencias \r\nde forma comparativa. Siempre optimizando el balance entre la congestión y el costo.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1},{&q;uuid&q;:&q;94b9e5c0-199a-4987-8f50-08bdddea4097&q;,&q;language&q;:&q;eng&q;,&q;value&q;:&q;This study reviews the impact that can be presented by the immersion of generation \r\nsources into the distribution network, with a technical, operational and commercial \r\napproach, given by the energy transactions between customer and operator. This requires \r\na mathematical arrangement to identify the balance between congestion and the operating \r\ncost of a microgrid when it is required the operation scheduling of the system in a day \r\nahead horizon time. Thus, the research is directed to the solution, using heuristic \r\nalgorithms, since they allow the non-convex constraints of the mathematical proposed \r\nproblem. \r\nThe optimization algorithm proposed for the analysis is given by the Multi-Object Particle \r\nSwarm Optimization (MOPSO) method, it provides a set of solutions that are known as \r\nOptimal Pareto. This algorithm is presented in an IEEE 141-bus system, which consists \r\nof a radial distribution network that considers 141 buses used by Matpower, this system \r\nwas modified and included a series of renewable generation injections, systems that \r\ncoordinate electric vehicles, battery storage and the slack node was maintained and \r\nassumed to have (traditional generation). \r\nIn the end it can be shown that the algorithm can provide solutions for network operation \r\nplanning, test system robustness and verify some contingencies comparatively. Always \r\noptimizing the balance between congestion and cost.&q;,&q;place&q;:1,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.degreelevel&q;:[{&q;uuid&q;:&q;0e6b6510-bf7b-4a6e-82d8-e81111135f1b&q;,&q;language&q;:&q;spa&q;,&q;value&q;:&q;Maestría&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.degreename&q;:[{&q;uuid&q;:&q;a6641ca3-20ff-4143-83a3-f370a9b9e881&q;,&q;language&q;:&q;spa&q;,&q;value&q;:&q;Magister en Ingeniería Eléctrica&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.researcharea&q;:[{&q;uuid&q;:&q;0a3575bd-b619-45dd-b594-fe6c43cf7c28&q;,&q;language&q;:&q;spa&q;,&q;value&q;:&q;Sistemas de Potencia&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1},{&q;uuid&q;:&q;97ae44be-da73-4bd2-abd4-391306418f0d&q;,&q;language&q;:&q;spa&q;,&q;value&q;:&q;Smart Grids&q;,&q;place&q;:1,&q;authority&q;:null,&q;confidence&q;:-1},{&q;uuid&q;:&q;3d25c8d6-e133-4817-b732-5b9bad060859&q;,&q;language&q;:&q;spa&q;,&q;value&q;:&q;Optimización usando algoritmos heurísticos&q;,&q;place&q;:2,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.extent&q;:[{&q;uuid&q;:&q;d7f756d4-b454-4aa5-ab9e-347f08757364&q;,&q;language&q;:&q;spa&q;,&q;value&q;:&q;1 recurso en linea (121 paginas)&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.mimetype&q;:[{&q;uuid&q;:&q;223a401c-9734-4209-8ff7-bb87228f0232&q;,&q;language&q;:&q;spa&q;,&q;value&q;:&q;application/pdf&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.instname&q;:[{&q;uuid&q;:&q;1f661aa4-6002-4654-b5dd-0b67e0981e8d&q;,&q;language&q;:&q;spa&q;,&q;value&q;:&q;Universidad Nacional de Colombia&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.reponame&q;:[{&q;uuid&q;:&q;fdff2cc3-c748-4d5a-b6ff-7b2ea362e865&q;,&q;language&q;:&q;spa&q;,&q;value&q;:&q;Repositorio Institucional Universidad Nacional de Colombia&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.repourl&q;:[{&q;uuid&q;:&q;e1db256a-a1fb-4cda-92c4-3ed82f30d669&q;,&q;language&q;:&q;spa&q;,&q;value&q;:&q;https://repositorio.unal.edu.co/&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;922a79e1-32cf-457c-bc84-c24385315056&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;https://repositorio.unal.edu.co/handle/unal/79615&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;d164eeed-fd2a-4013-8a3b-dde979c2fe4e&q;,&q;language&q;:&q;spa&q;,&q;value&q;:&q;spa&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;de85fb48-765d-4403-8a12-4bf06d282e48&q;,&q;language&q;:&q;spa&q;,&q;value&q;:&q;Universidad Nacional de Colombia&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher.branch&q;:[{&q;uuid&q;:&q;64d11c2b-332f-4330-9c28-69f2ffb4556b&q;,&q;language&q;:&q;spa&q;,&q;value&q;:&q;Universidad Nacional de Colombia - Sede Bogotá&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher.department&q;:[{&q;uuid&q;:&q;9c0d4378-a19e-49ee-ac38-11e399cee4